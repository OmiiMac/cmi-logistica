# ── CMI Logistica — Variables de Entorno ──────────────────────
# Copia este archivo como .env y rellena los valores

# API key de Resend (para enviar emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# ── Base de datos SQLite (autónoma) ───────────────────────────
# Ruta del archivo de base de datos. En Railway, apuntá esto al
# directorio de un VOLUMEN para que los datos sobrevivan a cada deploy.
# Ejemplo en Railway: montá un volumen en /data y poné DB_PATH=/data/cmi.db
DB_PATH=./data/cmi.db

# ── Seguridad de sesiones (JWT) ───────────────────────────────
# Opcional. Si no lo definís, el servidor genera uno y lo guarda en la
# propia base de datos. Si lo definís, usá una cadena larga y aleatoria.
# JWT_SECRET=pon_aqui_una_cadena_larga_y_aleatoria
